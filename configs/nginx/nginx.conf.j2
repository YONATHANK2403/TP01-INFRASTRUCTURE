# {{ ansible_managed }}
user nginx;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;
    sendfile      on;
    access_log    /var/log/nginx/access.log;

    upstream tp01_backend {
        server 127.0.0.1:8081;
    }

    # Backend applicatif interne (visible uniquement via le reverse proxy)
    server {
        listen 127.0.0.1:8081;
        location / {
            default_type application/json;
            return 200 '{"service":"tp01-backend","zone":"DMZ","host":"{{ inventory_hostname }}"}';
        }
    }

    # Frontal public de la DMZ
    server {
        listen 80 default_server;
        server_name web.{{ lab_domain }} _;
        root /usr/share/nginx/html;
        index index.html;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        location / {
            try_files $uri $uri/ =404;
        }

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "OK\n";
        }

        location /api/ {
            proxy_pass http://tp01_backend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
        }
    }
}
